# ============================================
# NUBORRO — .gitignore
# ============================================

# ---- SECRETS (NEVER COMMIT) ----
.env
.env.local
.env.production
.env*.local

# ---- DEPENDENCIES ----
node_modules/
.pnp
.pnp.js

# ---- NEXT.JS BUILD ----
.next/
out/
build/
dist/

# ---- SUPABASE LOCAL ----
supabase/.branches
supabase/.temp

# ---- TESTING ----
coverage/
.nyc_output

# ---- VERCEL ----
.vercel

# ---- OS FILES ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ---- EDITOR ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ---- LOGS ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- TYPESCRIPT ----
*.tsbuildinfo
next-env.d.ts

# ---- MISC ----
.cache
.parcel-cache
